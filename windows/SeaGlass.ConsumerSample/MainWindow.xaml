<Window
    x:Class="SeaGlass.ConsumerSample.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SeaGlass Minimal NuGet Consumer">

    <Grid>
        <NavigationView
            x:Name="NavView"
            PaneDisplayMode="Top"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavXamlItem" AutomationProperties.AutomationId="Nav_XamlPage" Content="XAML Controls (11)" Tag="xaml" IsSelected="True" />
                <NavigationViewItem x:Name="NavFluentItem" AutomationProperties.AutomationId="Nav_FluentPage" Content="Fluent C# Page (9)" Tag="fluent" />
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </NavigationView>
    </Grid>
</Window>
