  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SeaGlass.Core\SeaGlass.Core.csproj" />
    <ProjectReference Include="..\SeaGlass.WinUI\SeaGlass.WinUI.csproj" />
