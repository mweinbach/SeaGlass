<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SeaGlass.Sample</RootNamespace>
    <AssemblyName>SeaGlass.Sample</AssemblyName>
    <Description>Interactive SeaGlass Optical Lab &amp; Material 3 Expressive Showcase for Windows / WinUI 3.</Description>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Win2DWarnNoPlatform>false</Win2DWarnNoPlatform>
    <NoWarn>$(NoWarn);WIN2D0001;WMC1509</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SeaGlass.Core\SeaGlass.Core.csproj" />
    <ProjectReference Include="..\SeaGlass.WinUI\SeaGlass.WinUI.csproj" />
  </ItemGroup>

</Project>
