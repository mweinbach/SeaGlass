<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:sg="using:SeaGlass.WinUI">

    <!-- =================================================================== -->
    <!-- Group 8: Windows Native Extras                                     -->
    <!-- =================================================================== -->

    <!-- 1. SeaGlassTitleBar Template -->
    <ControlTemplate x:Key="SeaGlassTitleBarTemplate" TargetType="sg:SeaGlassTitleBar">
        <Grid x:Name="PART_Root" Height="48">
            <Border x:Name="PART_GlassHost"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            <Border Background="{ThemeResource SeaGlassSurfaceBackground}"
                    BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Col 0: App Icon -->
                    <Image x:Name="PART_IconPresenter"
                           Source="{TemplateBinding Icon}"
                           Width="16" Height="16"
                           Margin="16,0,8,0"
                           VerticalAlignment="Center" />
                    <!-- Col 1: Window Title -->
                    <TextBlock x:Name="PART_TitlePresenter"
                               Grid.Column="1"
                               Text="{TemplateBinding Title}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"
                               Foreground="{ThemeResource SeaGlassSurfaceForeground}" />
                    <!-- Col 2: Header Content -->
                    <ContentPresenter Grid.Column="2"
                                      Content="{TemplateBinding HeaderContent}"
                                      VerticalAlignment="Center" />
                    <!-- Col 3: Drag Region with Search Host -->
                    <Border x:Name="PART_DragRegion"
                            Grid.Column="3"
                            Background="Transparent">
                        <ContentPresenter x:Name="PART_SearchHost"
                                          Content="{TemplateBinding SearchContent}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <!-- Col 4: Footer Content -->
                    <ContentPresenter Grid.Column="4"
                                      Content="{TemplateBinding FooterContent}"
                                      VerticalAlignment="Center" />
                    <!-- Col 5: Caption Buttons Placeholder -->
                    <Border x:Name="PART_CaptionButtonsPlaceholder"
                            Grid.Column="5"
                            MinWidth="138"
                            IsHitTestVisible="False" />
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassTitleBar">
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="16,0,16,0" />
        <Setter Property="Template" Value="{StaticResource SeaGlassTitleBarTemplate}" />
    </Style>

    <!-- 2. SeaGlassNavigationView Template -->
    <ControlTemplate x:Key="SeaGlassNavigationViewTemplate" TargetType="sg:SeaGlassNavigationView">
        <Grid x:Name="PART_Root">
            <Border x:Name="PART_GlassHost"
                    Background="Transparent"
                    BorderThickness="0" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Navigation Pane -->
                <Border x:Name="PART_PaneRoot"
                        Width="280"
                        CornerRadius="0,16,16,0"
                        Background="{ThemeResource SeaGlassSurfaceBackground}"
                        BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Header Host -->
                        <ContentPresenter x:Name="PART_HeaderHost"
                                          Content="{TemplateBinding Header}"
                                          Margin="8,8,8,8" />
                        <!-- AutoSuggestBox Host -->
                        <ContentPresenter Grid.Row="1"
                                          Content="{TemplateBinding AutoSuggestBox}"
                                          Margin="8,0,8,8" />
                        <!-- Menu Items Strip -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Border x:Name="PART_SelectionLozenge"
                                        Height="36"
                                        CornerRadius="18"
                                        Background="{StaticResource SeaGlassToneSeafoamMintBrush}"
                                        Opacity="0.25"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Top"
                                        Visibility="Collapsed" />
                                <ItemsControl x:Name="PART_MenuItemsHost"
                                              ItemsSource="{TemplateBinding MenuItems}" />
                            </Grid>
                        </ScrollViewer>
                        <!-- Footer Menu Items -->
                        <ItemsControl x:Name="PART_FooterItemsHost"
                                      Grid.Row="3"
                                      ItemsSource="{TemplateBinding FooterMenuItems}"
                                      Margin="0,8,0,0" />
                    </Grid>
                </Border>
                <!-- Content Frame -->
                <Frame x:Name="PART_ContentFrame"
                       Grid.Column="1"
                       Margin="16" />
            </Grid>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassNavigationView">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template" Value="{StaticResource SeaGlassNavigationViewTemplate}" />
    </Style>

    <!-- 3. SeaGlassTabView Template -->
    <ControlTemplate x:Key="SeaGlassTabViewTemplate" TargetType="sg:SeaGlassTabView">
        <Grid x:Name="PART_Root">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="PART_GlassHost"
                    Grid.RowSpan="2"
                    Background="Transparent"
                    BorderThickness="0" />
            <!-- Tab Strip Bar -->
            <Border Background="{ThemeResource SeaGlassSurfaceBackground}"
                    BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="4,2,4,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Header -->
                    <ContentPresenter Content="{TemplateBinding TabStripHeader}"
                                      VerticalAlignment="Center"
                                      Margin="4,0,8,0" />
                    <!-- Tabs with Lozenge Indicator -->
                    <Grid Grid.Column="1">
                        <Border x:Name="PART_TabLozenge"
                                Height="32"
                                CornerRadius="16"
                                Background="{StaticResource SeaGlassToneSeafoamMintBrush}"
                                Opacity="0.3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center" />
                        <ItemsControl x:Name="PART_TabStrip"
                                      ItemsSource="{TemplateBinding TabItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                    <!-- Add Tab Button -->
                    <Button x:Name="PART_AddTabButton"
                            Grid.Column="2"
                            Content="＋"
                            Width="32" Height="32"
                            CornerRadius="16"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="4,0,4,0"
                            VerticalAlignment="Center" />
                    <!-- Footer -->
                    <ContentPresenter Grid.Column="3"
                                      Content="{TemplateBinding TabStripFooter}"
                                      VerticalAlignment="Center"
                                      Margin="8,0,4,0" />
                </Grid>
            </Border>
            <!-- Selected Content Host -->
            <ContentPresenter x:Name="PART_ContentHost"
                              Grid.Row="1"
                              Content="{TemplateBinding SelectedItem}"
                              Padding="16" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassTabView">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template" Value="{StaticResource SeaGlassTabViewTemplate}" />
    </Style>

    <!-- 4. SeaGlassCommandBar Template -->
    <ControlTemplate x:Key="SeaGlassCommandBarTemplate" TargetType="sg:SeaGlassCommandBar">
        <Grid x:Name="PART_Root">
            <Border x:Name="PART_GlassHost"
                    CornerRadius="20"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            <Border CornerRadius="20"
                    Background="{ThemeResource SeaGlassSurfaceBackground}"
                    BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                    BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <ItemsControl x:Name="PART_PrimaryItemsPresenter"
                                  ItemsSource="{TemplateBinding PrimaryCommands}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Button x:Name="PART_MoreButton"
                            Content="•••"
                            Width="36" Height="36"
                            CornerRadius="18"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <primitives:Popup x:Name="PART_OverflowPopup"
                              IsOpen="{TemplateBinding IsOpen}"
                              IsLightDismissEnabled="True">
                <Border CornerRadius="12"
                        Background="{ThemeResource SeaGlassSurfaceBackground}"
                        BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                        BorderThickness="1"
                        Padding="6"
                        Margin="0,4,0,0">
                    <ItemsControl x:Name="PART_SecondaryItemsHost"
                                  ItemsSource="{TemplateBinding SecondaryCommands}" />
                </Border>
            </primitives:Popup>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassCommandBar">
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="8,4,8,4" />
        <Setter Property="Template" Value="{StaticResource SeaGlassCommandBarTemplate}" />
    </Style>

    <!-- 5. SeaGlassInfoBar Template -->
    <ControlTemplate x:Key="SeaGlassInfoBarTemplate" TargetType="sg:SeaGlassInfoBar">
        <Grid x:Name="PART_Root">
            <Border x:Name="PART_GlassHost"
                    CornerRadius="14"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            <Border CornerRadius="14"
                    Background="{ThemeResource SeaGlassSurfaceBackground}"
                    BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                    BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Severity Icon -->
                    <ContentPresenter x:Name="PART_SeverityIcon"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center" />
                    <!-- Title and Message -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="PART_TitlePresenter"
                                   Text="{TemplateBinding Title}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{ThemeResource SeaGlassSurfaceForeground}" />
                        <TextBlock x:Name="PART_MessagePresenter"
                                   Text="{TemplateBinding Message}"
                                   FontSize="12"
                                   Opacity="0.88"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource SeaGlassSurfaceForeground}" />
                    </StackPanel>
                    <!-- Action Button Host -->
                    <ContentPresenter x:Name="PART_ActionButtonHost"
                                      Grid.Column="2"
                                      Content="{TemplateBinding ActionButton}"
                                      Margin="12,0,8,0"
                                      VerticalAlignment="Center" />
                    <!-- Close Button -->
                    <Button x:Name="PART_CloseButton"
                            Grid.Column="3"
                            Content="✕"
                            Width="28" Height="28"
                            CornerRadius="14"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassInfoBar">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Padding" Value="16,12,16,12" />
        <Setter Property="Template" Value="{StaticResource SeaGlassInfoBarTemplate}" />
    </Style>

    <!-- 6. SeaGlassTeachingTip Template -->
    <ControlTemplate x:Key="SeaGlassTeachingTipTemplate" TargetType="sg:SeaGlassTeachingTip">
        <Grid x:Name="PART_Root">
            <primitives:Popup x:Name="PART_Popup"
                              IsOpen="{TemplateBinding IsOpen}"
                              IsLightDismissEnabled="True">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path x:Name="PART_BeakPointer"
                          Data="M 0 10 L 10 0 L 20 10 Z"
                          Fill="{ThemeResource SeaGlassSurfaceBackground}"
                          HorizontalAlignment="Center" />
                    <Grid MaxWidth="340">
                        <Border x:Name="PART_GlassHost"
                                CornerRadius="16"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                        <Border CornerRadius="16"
                                Background="{ThemeResource SeaGlassSurfaceBackground}"
                                BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Spacing="8">
                                <ContentPresenter x:Name="PART_HeroPresenter"
                                                  Content="{TemplateBinding HeroContent}" />
                                <TextBlock x:Name="PART_TitlePresenter"
                                           Text="{TemplateBinding Title}"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           Foreground="{ThemeResource SeaGlassSurfaceForeground}" />
                                <TextBlock x:Name="PART_SubtitlePresenter"
                                           Text="{TemplateBinding Subtitle}"
                                           FontSize="13"
                                           Opacity="0.85"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource SeaGlassSurfaceForeground}" />
                                <ContentPresenter x:Name="PART_ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                                    <Button x:Name="PART_ActionButton"
                                            Content="{TemplateBinding ActionButtonContent}"
                                            CornerRadius="14"
                                            Padding="12,6,12,6" />
                                    <Button x:Name="PART_CloseButton"
                                            Content="{TemplateBinding CloseButtonContent}"
                                            CornerRadius="14"
                                            Padding="12,6,12,6"
                                            Background="Transparent"
                                            BorderThickness="0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </primitives:Popup>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassTeachingTip">
        <Setter Property="Padding" Value="18" />
        <Setter Property="Template" Value="{StaticResource SeaGlassTeachingTipTemplate}" />
    </Style>

    <!-- 7. SeaGlassFlyout Template -->
    <ControlTemplate x:Key="SeaGlassFlyoutTemplate" TargetType="sg:SeaGlassFlyout">
        <Grid x:Name="PART_Root">
            <primitives:Popup x:Name="PART_Popup"
                              IsOpen="{TemplateBinding IsOpen}"
                              IsLightDismissEnabled="True">
                <Grid MaxWidth="320" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="PART_GlassHost"
                            CornerRadius="14"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
                    <Border CornerRadius="14"
                            Background="{ThemeResource SeaGlassSurfaceBackground}"
                            BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding FlyoutContent}" />
                    </Border>
                </Grid>
            </primitives:Popup>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassFlyout">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Template" Value="{StaticResource SeaGlassFlyoutTemplate}" />
    </Style>

    <!-- 8. SeaGlassToolTip Template -->
    <ControlTemplate x:Key="SeaGlassToolTipTemplate" TargetType="sg:SeaGlassToolTip">
        <Grid x:Name="PART_Root">
            <Border x:Name="PART_GlassHost"
                    CornerRadius="8"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            <Border CornerRadius="8"
                    Background="{ThemeResource SeaGlassSurfaceBackground}"
                    BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                    BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassToolTip">
        <Setter Property="Padding" Value="10,6,10,6" />
        <Setter Property="Template" Value="{StaticResource SeaGlassToolTipTemplate}" />
    </Style>

</ResourceDictionary>
