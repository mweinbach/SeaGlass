<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sg="using:SeaGlass.WinUI">

    <!-- Group 1: Foundations & Surfaces -->

    <ControlTemplate x:Key="DefaultSeaGlassSurfaceTemplate" TargetType="sg:SeaGlassSurface">
        <Grid>
            <Border x:Name="PART_GlassHost"
                    Background="{ThemeResource SeaGlassSurfaceBackground}"
                    BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16" />
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            <Border x:Name="PART_FocusVisual"
                    BorderBrush="{StaticResource SeaGlassFocusStrokeBrush}"
                    BorderThickness="2"
                    CornerRadius="18"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver" />
                    <VisualState x:Name="Pressed" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="PART_GlassHost.Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Unfocused" />
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="PART_FocusVisual.Visibility" Value="Visible" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <!-- SeaGlassSurface Style -->
    <Style TargetType="sg:SeaGlassSurface">
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="16,12,16,12" />
        <Setter Property="Template" Value="{StaticResource DefaultSeaGlassSurfaceTemplate}" />
    </Style>

    <!-- SeaGlassCard Style -->
    <Style TargetType="sg:SeaGlassCard">
        <Setter Property="Padding" Value="20,16,20,16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sg:SeaGlassCard">
                    <Grid>
                        <Border x:Name="PART_GlassHost"
                                Background="{ThemeResource SeaGlassSurfaceBackground}"
                                BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="20" />
                        <Grid Padding="{TemplateBinding Padding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="PART_TitlePresenter"
                                       Text="{TemplateBinding Title}"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       Foreground="{ThemeResource SeaGlassSurfaceForeground}" />
                            <TextBlock x:Name="PART_SubtitlePresenter"
                                       Grid.Row="1"
                                       Text="{TemplateBinding Subtitle}"
                                       FontSize="13"
                                       Opacity="0.75"
                                       Foreground="{ThemeResource SeaGlassSurfaceForeground}" />
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Grid.Row="2"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Margin="0,8,0,0" />
                        </Grid>
                        <Border x:Name="PART_FocusVisual"
                                BorderBrush="{StaticResource SeaGlassFocusStrokeBrush}"
                                BorderThickness="2"
                                CornerRadius="22"
                                Visibility="Collapsed"
                                IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SeaGlassDialogCard Style -->
    <Style TargetType="sg:SeaGlassDialogCard">
        <Setter Property="Padding" Value="24,20,24,20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sg:SeaGlassDialogCard">
                    <Grid>
                        <Border x:Name="PART_GlassHost"
                                Background="{ThemeResource SeaGlassSurfaceBackground}"
                                BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="24" />
                        <Grid Padding="{TemplateBinding Padding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Title & Subtitle Presenters -->
                            <TextBlock x:Name="PART_TitlePresenter"
                                       Text="{TemplateBinding Title}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"
                                       Foreground="{ThemeResource SeaGlassSurfaceForeground}" />
                            <TextBlock x:Name="PART_SubtitlePresenter"
                                       Text="{TemplateBinding Subtitle}"
                                       FontSize="13"
                                       Opacity="0.75"
                                       Margin="0,0,0,8"
                                       Foreground="{ThemeResource SeaGlassSurfaceForeground}" />
                            <!-- Body Presenter & Custom Content -->
                            <StackPanel Grid.Row="1" Spacing="8">
                                <TextBlock x:Name="PART_BodyPresenter"
                                           Text="{TemplateBinding Body}"
                                           FontSize="14"
                                           Opacity="0.88"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource SeaGlassSurfaceForeground}" />
                                <ContentPresenter x:Name="PART_ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </StackPanel>
                            <!-- Modal Action Buttons -->
                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="8"
                                        Margin="0,16,0,0">
                                <Button x:Name="PART_DismissButton"
                                        Content="{TemplateBinding DismissLabel}"
                                        MinWidth="84"
                                        Height="36"
                                        CornerRadius="18"
                                        Background="Transparent"
                                        BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                                        BorderThickness="1" />
                                <Button x:Name="PART_ConfirmButton"
                                        Content="{TemplateBinding ConfirmLabel}"
                                        MinWidth="84"
                                        Height="36"
                                        CornerRadius="18"
                                        Background="{ThemeResource SeaGlassToneSeafoamMintBrush}"
                                        Foreground="{ThemeResource SeaGlassOnToneSeafoamMintBrush}" />
                            </StackPanel>
                        </Grid>
                        <Border x:Name="PART_FocusVisual"
                                BorderBrush="{StaticResource SeaGlassFocusStrokeBrush}"
                                BorderThickness="2"
                                CornerRadius="26"
                                Visibility="Collapsed"
                                IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SeaGlassBottomSheetSurface Style -->
    <Style TargetType="sg:SeaGlassBottomSheetSurface">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sg:SeaGlassBottomSheetSurface">
                    <Grid>
                        <Border x:Name="PART_GlassHost"
                                Background="{ThemeResource SeaGlassSurfaceBackground}"
                                BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="28,28,0,0" />
                        <Grid Padding="{TemplateBinding Padding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="PART_DragHandle"
                                    Width="40" Height="5"
                                    CornerRadius="3"
                                    Background="{ThemeResource SeaGlassRimHighlightBrush}"
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,12" />
                            <StackPanel x:Name="PART_HeaderPresenter"
                                        Grid.Row="1"
                                        Margin="0,0,0,12"
                                        Spacing="4">
                                <TextBlock x:Name="PART_TitlePresenter"
                                           Text="{TemplateBinding Title}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource SeaGlassSurfaceForeground}" />
                                <TextBlock x:Name="PART_SubtitlePresenter"
                                           Text="{TemplateBinding Subtitle}"
                                           FontSize="13"
                                           Opacity="0.8"
                                           Foreground="{ThemeResource SeaGlassSurfaceForeground}" />
                            </StackPanel>
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Grid.Row="2"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                        <Border x:Name="PART_FocusVisual"
                                BorderBrush="{StaticResource SeaGlassFocusStrokeBrush}"
                                BorderThickness="2"
                                CornerRadius="30,30,0,0"
                                Visibility="Collapsed"
                                IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SeaGlassCornerEmbeddedPod Style -->
    <Style TargetType="sg:SeaGlassCornerEmbeddedPod">
        <Setter Property="Template" Value="{StaticResource DefaultSeaGlassSurfaceTemplate}" />
    </Style>

    <!-- SeaGlassAdaptiveCornerLabCard Style -->
    <Style TargetType="sg:SeaGlassAdaptiveCornerLabCard">
        <Setter Property="Padding" Value="20,16,20,16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sg:SeaGlassAdaptiveCornerLabCard">
                    <Grid>
                        <Border x:Name="PART_GlassHost"
                                Background="{ThemeResource SeaGlassSurfaceBackground}"
                                BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="20" />
                        <Grid Padding="{TemplateBinding Padding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="PART_TitlePresenter"
                                       Text="{TemplateBinding Title}"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       Foreground="{ThemeResource SeaGlassSurfaceForeground}" />
                            <TextBlock x:Name="PART_SubtitlePresenter"
                                       Grid.Row="1"
                                       Text="{TemplateBinding Subtitle}"
                                       FontSize="13"
                                       Opacity="0.75"
                                       Foreground="{ThemeResource SeaGlassSurfaceForeground}" />
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Grid.Row="2"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Margin="0,8,0,0" />
                        </Grid>
                        <Border x:Name="PART_FocusVisual"
                                BorderBrush="{StaticResource SeaGlassFocusStrokeBrush}"
                                BorderThickness="2"
                                CornerRadius="22"
                                Visibility="Collapsed"
                                IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SeaGlassSurfaceContainer Style -->
    <Style TargetType="sg:SeaGlassSurfaceContainer">
        <Setter Property="Template" Value="{StaticResource DefaultSeaGlassSurfaceTemplate}" />
    </Style>

    <!-- SeaGlassBackdropHost Style -->
    <Style TargetType="sg:SeaGlassBackdropHost">
        <Setter Property="Template" Value="{StaticResource DefaultSeaGlassSurfaceTemplate}" />
    </Style>


    <!-- SeaGlassStage Style -->
    <Style TargetType="sg:SeaGlassStage">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sg:SeaGlassStage">
                    <Grid>
                        <Border x:Name="PART_BackdropHost"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
