<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sg="using:SeaGlass.WinUI">

    <!-- =================================================================== -->
    <!-- Group 2: Buttons & Chips                                           -->
    <!-- =================================================================== -->

    <!-- Base SeaGlassButton Template -->
    <ControlTemplate x:Key="DefaultSeaGlassButtonTemplate" TargetType="sg:SeaGlassButton">
        <Grid x:Name="PART_Root">
            <Border x:Name="PART_GlassHost"
                    Background="{ThemeResource SeaGlassSurfaceBackground}"
                    BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="20" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="{TemplateBinding Padding}">
                <ContentPresenter x:Name="PART_IconPresenter"
                                  Content="{TemplateBinding IconGlyph}"
                                  Visibility="Collapsed"
                                  Margin="0,0,8,0" />
                <TextBlock x:Name="PART_LabelPresenter"
                           Text="{TemplateBinding Label}"
                           FontWeight="Medium"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SeaGlassSurfaceForeground}" />
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />
            </StackPanel>
            <Border x:Name="PART_FocusVisual"
                    BorderBrush="{StaticResource SeaGlassFocusStrokeBrush}"
                    BorderThickness="2"
                    CornerRadius="22"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="PART_GlassHost.BorderBrush" Value="{StaticResource SeaGlassRimHighlightBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="PART_GlassHost.Opacity" Value="0.88" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="PART_GlassHost.Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassButton">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="18,10,18,10" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource DefaultSeaGlassButtonTemplate}" />
    </Style>

    <!-- Dedicated SeaGlassIconButton Template -->
    <ControlTemplate x:Key="SeaGlassIconButtonTemplate" TargetType="sg:SeaGlassIconButton">
        <Grid x:Name="PART_Root" Width="40" Height="40">
            <Border x:Name="PART_GlassHost"
                    CornerRadius="20"
                    Background="{ThemeResource SeaGlassSurfaceBackground}"
                    BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                    BorderThickness="1" />
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{TemplateBinding Padding}">
                <ContentPresenter x:Name="PART_IconPresenter"
                                  Content="{TemplateBinding IconGlyph}" />
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Visibility="Collapsed" />
            </Grid>
            <Border x:Name="PART_FocusVisual"
                    BorderBrush="{StaticResource SeaGlassFocusStrokeBrush}"
                    BorderThickness="2"
                    CornerRadius="22"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="PART_GlassHost.BorderBrush" Value="{StaticResource SeaGlassRimHighlightBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="PART_GlassHost.Opacity" Value="0.85" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="PART_GlassHost.Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassIconButton">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Template" Value="{StaticResource SeaGlassIconButtonTemplate}" />
    </Style>

    <!-- Dedicated SeaGlassExtendedFab Template -->
    <ControlTemplate x:Key="SeaGlassExtendedFabTemplate" TargetType="sg:SeaGlassExtendedFab">
        <Grid x:Name="PART_Root" Height="56">
            <Border x:Name="PART_GlassHost"
                    CornerRadius="28"
                    Background="{StaticResource SeaGlassToneSeafoamMintBrush}"
                    BorderBrush="{StaticResource SeaGlassRimHighlightBrush}"
                    BorderThickness="1" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="{TemplateBinding Padding}"
                        Spacing="8">
                <ContentPresenter x:Name="PART_IconPresenter"
                                  Content="{TemplateBinding IconGlyph}"
                                  Visibility="Collapsed"
                                  VerticalAlignment="Center" />
                <TextBlock x:Name="PART_LabelPresenter"
                           Text="{TemplateBinding Label}"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Foreground="{ThemeResource SeaGlassSurfaceForeground}"
                           VerticalAlignment="Center" />
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />
            </StackPanel>
            <Border x:Name="PART_FocusVisual"
                    BorderBrush="{StaticResource SeaGlassFocusStrokeBrush}"
                    BorderThickness="2"
                    CornerRadius="30"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="PART_GlassHost.Opacity" Value="0.95" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="PART_GlassHost.Opacity" Value="0.85" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="PART_GlassHost.Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassExtendedFab">
        <Setter Property="Height" Value="56" />
        <Setter Property="Padding" Value="20,14,20,14" />
        <Setter Property="Template" Value="{StaticResource SeaGlassExtendedFabTemplate}" />
    </Style>

    <!-- Dedicated SeaGlassFilterChip Template -->
    <ControlTemplate x:Key="SeaGlassFilterChipTemplate" TargetType="sg:SeaGlassFilterChip">
        <Grid x:Name="PART_Root" Height="32">
            <Border x:Name="PART_GlassHost"
                    CornerRadius="16"
                    Background="{ThemeResource SeaGlassSurfaceBackground}"
                    BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                    BorderThickness="1" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="{TemplateBinding Padding}"
                        Spacing="6">
                <ContentPresenter x:Name="PART_CheckmarkPresenter"
                                  Content="{TemplateBinding LeadingGlyph}"
                                  Visibility="Collapsed"
                                  VerticalAlignment="Center" />
                <ContentPresenter x:Name="PART_IconPresenter"
                                  Content="{TemplateBinding IconGlyph}"
                                  Visibility="Collapsed"
                                  VerticalAlignment="Center" />
                <TextBlock x:Name="PART_LabelPresenter"
                           Text="{TemplateBinding Label}"
                           FontWeight="Medium"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SeaGlassSurfaceForeground}" />
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />
            </StackPanel>
            <Border x:Name="PART_FocusVisual"
                    BorderBrush="{StaticResource SeaGlassFocusStrokeBrush}"
                    BorderThickness="2"
                    CornerRadius="18"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="PART_GlassHost.BorderBrush" Value="{StaticResource SeaGlassRimHighlightBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="PART_GlassHost.Opacity" Value="0.85" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="PART_GlassHost.Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="SelectionStates">
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Target="PART_GlassHost.Background" Value="{StaticResource SeaGlassToneSeafoamMintBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unselected" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassFilterChip">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,6,12,6" />
        <Setter Property="Template" Value="{StaticResource SeaGlassFilterChipTemplate}" />
    </Style>

    <!-- Dedicated SeaGlassPill Template -->
    <ControlTemplate x:Key="SeaGlassPillTemplate" TargetType="sg:SeaGlassPill">
        <Grid x:Name="PART_Root" Height="32">
            <Border x:Name="PART_GlassHost"
                    CornerRadius="16"
                    Background="{ThemeResource SeaGlassSurfaceBackground}"
                    BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                    BorderThickness="1" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="{TemplateBinding Padding}"
                        Spacing="6">
                <ContentPresenter x:Name="PART_IconPresenter"
                                  Content="{TemplateBinding IconGlyph}"
                                  Visibility="Collapsed"
                                  VerticalAlignment="Center" />
                <TextBlock x:Name="PART_LabelPresenter"
                           Text="{TemplateBinding Label}"
                           FontWeight="Medium"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SeaGlassSurfaceForeground}" />
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />
            </StackPanel>
            <Border x:Name="PART_FocusVisual"
                    BorderBrush="{StaticResource SeaGlassFocusStrokeBrush}"
                    BorderThickness="2"
                    CornerRadius="18"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="PART_GlassHost.BorderBrush" Value="{StaticResource SeaGlassRimHighlightBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="PART_GlassHost.Opacity" Value="0.85" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="PART_GlassHost.Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="SelectionStates">
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Target="PART_GlassHost.Background" Value="{StaticResource SeaGlassToneCobaltTideBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unselected" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassPill">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,6,14,6" />
        <Setter Property="Template" Value="{StaticResource SeaGlassPillTemplate}" />
    </Style>

    <!-- SeaGlassBadge Style -->
    <Style TargetType="sg:SeaGlassBadge">
        <Setter Property="Height" Value="22" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="Padding" Value="8,2,8,2" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sg:SeaGlassBadge">
                    <Grid x:Name="PART_Root">
                        <Border x:Name="PART_GlassHost"
                                Background="{ThemeResource SeaGlassSurfaceBackground}"
                                BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11" />
                        <TextBlock x:Name="PART_TextPresenter"
                                   Text="{TemplateBinding Text}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   Foreground="{ThemeResource SeaGlassSurfaceForeground}"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   Padding="{TemplateBinding Padding}" />
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Visibility="Collapsed" />
                        <Border x:Name="PART_FocusVisual"
                                BorderBrush="{StaticResource SeaGlassFocusStrokeBrush}"
                                BorderThickness="2"
                                CornerRadius="13"
                                Visibility="Collapsed"
                                IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SeaGlassSegmentedButtonRow Style -->
    <Style TargetType="sg:SeaGlassSegmentedButtonRow">
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sg:SeaGlassSegmentedButtonRow">
                    <Grid x:Name="PART_Root">
                        <Border x:Name="PART_GlassHost"
                                Background="{ThemeResource SeaGlassSurfaceBackground}"
                                BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="22"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="PART_IndicatorLozenge"
                                        Height="36"
                                        CornerRadius="18"
                                        Background="{StaticResource SeaGlassToneSeafoamMintBrush}"
                                        Opacity="0.3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                <ItemsControl x:Name="PART_ItemsHost"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border x:Name="PART_FocusVisual"
                                BorderBrush="{StaticResource SeaGlassFocusStrokeBrush}"
                                BorderThickness="2"
                                CornerRadius="24"
                                Visibility="Collapsed"
                                IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SeaGlassSegmentedButtonItem Style -->
    <Style TargetType="sg:SeaGlassSegmentedButtonItem">
        <Setter Property="Padding" Value="16,8,16,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sg:SeaGlassSegmentedButtonItem">
                    <Border x:Name="PART_GlassHost"
                            CornerRadius="18">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SeaGlassPebbleOrb Style -->
    <Style TargetType="sg:SeaGlassPebbleOrb">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sg:SeaGlassPebbleOrb">
                    <Grid x:Name="PART_Root">
                        <Border x:Name="PART_GlassHost"
                                CornerRadius="24"
                                Background="{ThemeResource SeaGlassSurfaceBackground}"
                                BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                                BorderThickness="1" />
                        <Grid Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="PART_GlyphPresenter"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Visibility="Collapsed" />
                        </Grid>
                        <Border x:Name="PART_FocusVisual"
                                BorderBrush="{StaticResource SeaGlassFocusStrokeBrush}"
                                BorderThickness="2"
                                CornerRadius="26"
                                Visibility="Collapsed"
                                IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
