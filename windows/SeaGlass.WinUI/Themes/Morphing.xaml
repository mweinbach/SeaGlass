<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shapes="using:Microsoft.UI.Xaml.Shapes"
    xmlns:sg="using:SeaGlass.WinUI">

    <!-- =================================================================== -->
    <!-- Group 6: Dynamic Morphing Suite                                    -->
    <!-- =================================================================== -->

    <!-- 1. SeaGlassTwoElementMorph Template -->
    <ControlTemplate x:Key="SeaGlassTwoElementMorphTemplate" TargetType="sg:SeaGlassTwoElementMorph">
        <Grid x:Name="PART_Root">
            <Border x:Name="PART_GlassHost"
                    CornerRadius="16"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            <Border CornerRadius="16"
                    Background="{ThemeResource SeaGlassSurfaceBackground}"
                    BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                    BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
                <Grid>
                    <Canvas x:Name="PART_GlassCanvas" />
                    <ContentPresenter x:Name="PART_CollapsedHost"
                                      Content="{TemplateBinding Content}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center" />
                    <ContentPresenter x:Name="PART_ExpandedHost"
                                      Visibility="Collapsed"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassTwoElementMorph">
        <Setter Property="Padding" Value="8" />
        <Setter Property="Template" Value="{StaticResource SeaGlassTwoElementMorphTemplate}" />
    </Style>

    <!-- 2. SeaGlassBuddingCluster Template -->
    <ControlTemplate x:Key="SeaGlassBuddingClusterTemplate" TargetType="sg:SeaGlassBuddingCluster">
        <Grid x:Name="PART_Root">
            <Border x:Name="PART_GlassHost"
                    Background="Transparent"
                    BorderThickness="0" />
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="PART_AnchorOrb"
                        Content="✦"
                        Width="56" Height="56"
                        CornerRadius="28"
                        Background="{ThemeResource SeaGlassToneSeafoamMintBrush}"
                        Foreground="{ThemeResource SeaGlassOnToneSeafoamMintBrush}" />
                <ItemsControl x:Name="PART_SatellitesHost"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassBuddingCluster">
        <Setter Property="Template" Value="{StaticResource SeaGlassBuddingClusterTemplate}" />
    </Style>

    <!-- 3. SeaGlassMorphingButton Template -->
    <ControlTemplate x:Key="SeaGlassMorphingButtonTemplate" TargetType="sg:SeaGlassMorphingButton">
        <Grid x:Name="PART_Root">
            <Border x:Name="PART_GlassHost"
                    CornerRadius="20"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            <Border CornerRadius="20"
                    Background="{ThemeResource SeaGlassSurfaceBackground}"
                    BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                    BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                        <TextBlock x:Name="PART_LabelPresenter"
                                   Text="{TemplateBinding ButtonLabel}"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource SeaGlassSurfaceForeground}" />
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassMorphingButton">
        <Setter Property="Padding" Value="16,8,16,8" />
        <Setter Property="Template" Value="{StaticResource SeaGlassMorphingButtonTemplate}" />
    </Style>

    <!-- 4. SeaGlassChoreographedShapeOrb Template -->
    <ControlTemplate x:Key="SeaGlassChoreographedShapeOrbTemplate" TargetType="sg:SeaGlassChoreographedShapeOrb">
        <Grid x:Name="PART_Root" Width="116" Height="116">
            <Border x:Name="PART_GlassHost"
                    CornerRadius="58"
                    Background="{ThemeResource SeaGlassSurfaceBackground}"
                    BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                    BorderThickness="1" />
            <Canvas x:Name="PART_ShapeCanvas">
                <Path x:Name="PART_ShapePath"
                      Fill="{StaticResource SeaGlassToneCobaltTideBrush}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Canvas>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassChoreographedShapeOrb">
        <Setter Property="Width" Value="116" />
        <Setter Property="Height" Value="116" />
        <Setter Property="Template" Value="{StaticResource SeaGlassChoreographedShapeOrbTemplate}" />
    </Style>

    <!-- 5. SeaGlassMultiShapeMorph Template -->
    <ControlTemplate x:Key="SeaGlassMultiShapeMorphTemplate" TargetType="sg:SeaGlassMultiShapeMorph">
        <Grid x:Name="PART_Root">
            <Border x:Name="PART_GlassHost"
                    CornerRadius="24"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            <Border CornerRadius="24"
                    Background="{ThemeResource SeaGlassSurfaceBackground}"
                    BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                    BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
                <Grid>
                    <Path x:Name="PART_MorphedPath"
                          Fill="{StaticResource SeaGlassToneSeaLavenderBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassMultiShapeMorph">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Template" Value="{StaticResource SeaGlassMultiShapeMorphTemplate}" />
    </Style>

    <!-- 6. SeaGlassMorphingContextMenu Template -->
    <ControlTemplate x:Key="SeaGlassMorphingContextMenuTemplate" TargetType="sg:SeaGlassMorphingContextMenu">
        <Grid x:Name="PART_Root">
            <Border x:Name="PART_GlassHost"
                    CornerRadius="20"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            <Border CornerRadius="20"
                    Background="{ThemeResource SeaGlassSurfaceBackground}"
                    BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                    BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
                <StackPanel Spacing="8">
                    <!-- Quick Header Actions -->
                    <StackPanel x:Name="PART_QuickActionsHost"
                                Orientation="Horizontal"
                                Spacing="6"
                                HorizontalAlignment="Center" />
                    <!-- Menu Rows -->
                    <ItemsControl x:Name="PART_MenuRowsHost" />
                </StackPanel>
            </Border>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassMorphingContextMenu">
        <Setter Property="Padding" Value="12" />
        <Setter Property="Template" Value="{StaticResource SeaGlassMorphingContextMenuTemplate}" />
    </Style>

    <!-- 7. SeaGlassCascadedModelMorph Template -->
    <ControlTemplate x:Key="SeaGlassCascadedModelMorphTemplate" TargetType="sg:SeaGlassCascadedModelMorph">
        <Grid x:Name="PART_Root">
            <Border x:Name="PART_GlassHost"
                    CornerRadius="20"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            <Border CornerRadius="20"
                    Background="{ThemeResource SeaGlassSurfaceBackground}"
                    BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                    BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
                <StackPanel Spacing="10">
                    <Border x:Name="PART_PillHeader"
                            Height="36"
                            CornerRadius="18"
                            Background="{ThemeResource SeaGlassSurfaceBorderBrush}"
                            Padding="12,6,12,6">
                        <TextBlock Text="{TemplateBinding SelectedModel}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource SeaGlassSurfaceForeground}" />
                    </Border>
                    <Border x:Name="PART_PopoverBody"
                            CornerRadius="12"
                            Background="{ThemeResource SeaGlassSurfaceBackground}"
                            Padding="8">
                        <Slider x:Name="PART_EffortSlider"
                                Minimum="0.0"
                                Maximum="1.0"
                                Value="{TemplateBinding EffortFraction}" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassCascadedModelMorph">
        <Setter Property="Padding" Value="12" />
        <Setter Property="Template" Value="{StaticResource SeaGlassCascadedModelMorphTemplate}" />
    </Style>

    <!-- 8. SeaGlassContextRingMorph Template -->
    <ControlTemplate x:Key="SeaGlassContextRingMorphTemplate" TargetType="sg:SeaGlassContextRingMorph">
        <Grid x:Name="PART_Root">
            <Border x:Name="PART_GlassHost"
                    CornerRadius="18"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            <Border CornerRadius="18"
                    Background="{ThemeResource SeaGlassSurfaceBackground}"
                    BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                    BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Ring Presenter -->
                    <Canvas x:Name="PART_RingPresenter"
                            Width="38" Height="38"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0" />
                    <!-- Details Presenter -->
                    <ContentPresenter x:Name="PART_DetailsPresenter"
                                      Grid.Column="1"
                                      VerticalAlignment="Center">
                        <StackPanel Spacing="2">
                            <TextBlock Text="366K of 1.05M tokens"
                                       FontWeight="Medium"
                                       FontSize="13"
                                       Foreground="{ThemeResource SeaGlassSurfaceForeground}" />
                            <TextBlock Text="683K left"
                                       FontSize="11"
                                       Opacity="0.75"
                                       Foreground="{ThemeResource SeaGlassSurfaceForeground}" />
                        </StackPanel>
                    </ContentPresenter>
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassContextRingMorph">
        <Setter Property="Padding" Value="10" />
        <Setter Property="Template" Value="{StaticResource SeaGlassContextRingMorphTemplate}" />
    </Style>

    <!-- Morphing Aliases -->
    <Style TargetType="sg:SeaGlassLiquidBlobMorph">
        <Setter Property="Template" Value="{StaticResource SeaGlassTwoElementMorphTemplate}" />
    </Style>
    <Style TargetType="sg:SeaGlassStateDrivenMorph">
        <Setter Property="Template" Value="{StaticResource SeaGlassTwoElementMorphTemplate}" />
    </Style>
    <Style TargetType="sg:SeaGlassFluidShapeBridge">
        <Setter Property="Template" Value="{StaticResource SeaGlassTwoElementMorphTemplate}" />
    </Style>

</ResourceDictionary>
