<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:sg="using:SeaGlass.WinUI">

    <!-- =================================================================== -->
    <!-- Group 4: Inputs & Toggles                                          -->
    <!-- =================================================================== -->

    <!-- 1. SeaGlassTextField Template -->
    <ControlTemplate x:Key="SeaGlassTextFieldTemplate" TargetType="sg:SeaGlassTextField">
        <Grid x:Name="PART_Root">
            <Border x:Name="PART_GlassHost"
                    Background="{ThemeResource SeaGlassSurfaceBackground}"
                    BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14" />
            <Grid Padding="{TemplateBinding Padding}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Label Row -->
                <TextBlock x:Name="PART_LabelPresenter"
                           Text="{TemplateBinding Label}"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{ThemeResource SeaGlassSurfaceForeground}"
                           Margin="0,0,0,2"
                           VerticalAlignment="Center" />
                <!-- Input Row -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="PART_LeadingGlyph"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center" />
                    <TextBox x:Name="PART_TextBox"
                             Grid.Column="1"
                             Text="{TemplateBinding Value}"
                             PlaceholderText="{TemplateBinding Placeholder}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             VerticalAlignment="Center"
                             Foreground="{ThemeResource SeaGlassSurfaceForeground}" />
                    <ContentPresenter x:Name="PART_TrailingGlyph"
                                      Grid.Column="2"
                                      Margin="8,0,0,0"
                                      VerticalAlignment="Center" />
                </Grid>
                <!-- Error Message Row -->
                <TextBlock x:Name="PART_ErrorMessagePresenter"
                           Grid.Row="2"
                           Text="{TemplateBinding ErrorMessage}"
                           FontSize="11"
                           Foreground="{StaticResource SeaGlassToneRoseQuartzShellBrush}"
                           Margin="0,2,0,0"
                           Visibility="Collapsed" />
            </Grid>
            <Border x:Name="PART_FocusVisual"
                    BorderBrush="{StaticResource SeaGlassFocusStrokeBrush}"
                    BorderThickness="2"
                    CornerRadius="16"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="PART_GlassHost.BorderBrush" Value="{StaticResource SeaGlassRimHighlightBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="PART_FocusVisual.Visibility" Value="Visible" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="PART_GlassHost.Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="ErrorStates">
                    <VisualState x:Name="NoError" />
                    <VisualState x:Name="HasError">
                        <VisualState.Setters>
                            <Setter Target="PART_ErrorMessagePresenter.Visibility" Value="Visible" />
                            <Setter Target="PART_GlassHost.BorderBrush" Value="{StaticResource SeaGlassToneRoseQuartzShellBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassTextField">
        <Setter Property="Height" Value="58" />
        <Setter Property="Padding" Value="16,8,16,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource SeaGlassTextFieldTemplate}" />
    </Style>

    <!-- 2. SeaGlassSwitch Template -->
    <ControlTemplate x:Key="SeaGlassSwitchTemplate" TargetType="sg:SeaGlassSwitch">
        <Grid x:Name="PART_Root" Width="56" Height="32">
            <Border x:Name="PART_GlassHost"
                    Width="52"
                    Height="32"
                    CornerRadius="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0" />
            <Border x:Name="PART_TrackWell"
                    Width="52"
                    Height="32"
                    CornerRadius="16"
                    Background="{ThemeResource SeaGlassSurfaceBackground}"
                    BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                    BorderThickness="1">
                <Border x:Name="PART_ThumbLens"
                        Width="24"
                        Height="24"
                        CornerRadius="12"
                        BorderBrush="{StaticResource SeaGlassRimHighlightBrush}"
                        BorderThickness="1.2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="4,0,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#66FFFFFF" Offset="0.0" />
                            <GradientStop Color="#22FFFFFF" Offset="0.45" />
                            <GradientStop Color="#44DCFFF6" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Border>
            <Border x:Name="PART_FocusVisual"
                    Width="56"
                    Height="36"
                    CornerRadius="18"
                    BorderBrush="{StaticResource SeaGlassFocusStrokeBrush}"
                    BorderThickness="2"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="PART_TrackWell.BorderBrush" Value="{StaticResource SeaGlassRimHighlightBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="PART_ThumbLens.Opacity" Value="0.88" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="PART_Root.Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CheckStates">
                    <VisualState x:Name="Checked">
                        <VisualState.Setters>
                            <Setter Target="PART_ThumbLens.HorizontalAlignment" Value="Right" />
                            <Setter Target="PART_ThumbLens.Margin" Value="0,0,4,0" />
                            <Setter Target="PART_TrackWell.Background" Value="{StaticResource SeaGlassToneSeafoamMintBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unchecked">
                        <VisualState.Setters>
                            <Setter Target="PART_ThumbLens.HorizontalAlignment" Value="Left" />
                            <Setter Target="PART_ThumbLens.Margin" Value="4,0,0,0" />
                            <Setter Target="PART_TrackWell.Background" Value="{ThemeResource SeaGlassSurfaceBackground}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassSwitch">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Template" Value="{StaticResource SeaGlassSwitchTemplate}" />
    </Style>

    <!-- 3. SeaGlassCheckbox Template -->
    <ControlTemplate x:Key="SeaGlassCheckboxTemplate" TargetType="sg:SeaGlassCheckbox">
        <Grid x:Name="PART_Root">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Grid Width="22" Height="22" VerticalAlignment="Center">
                    <Border x:Name="PART_GlassHost"
                            Width="22"
                            Height="22"
                            CornerRadius="6"
                            Background="Transparent"
                            BorderThickness="0" />
                    <Border x:Name="PART_BoxContour"
                            CornerRadius="6"
                            BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                            BorderThickness="1.5"
                            Background="{ThemeResource SeaGlassSurfaceBackground}" />
                    <Path x:Name="PART_Checkmark"
                          Data="M 4 11 L 9 16 L 18 6"
                          Stroke="{ThemeResource SeaGlassSurfaceForeground}"
                          StrokeThickness="2.5"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Visibility="Collapsed" />
                </Grid>
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  VerticalAlignment="Center" />
            </StackPanel>
            <Border x:Name="PART_FocusVisual"
                    CornerRadius="8"
                    BorderBrush="{StaticResource SeaGlassFocusStrokeBrush}"
                    BorderThickness="2"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="PART_BoxContour.BorderBrush" Value="{StaticResource SeaGlassRimHighlightBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="PART_BoxContour.Opacity" Value="0.8" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="PART_Root.Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CheckStates">
                    <VisualState x:Name="Checked">
                        <VisualState.Setters>
                            <Setter Target="PART_Checkmark.Visibility" Value="Visible" />
                            <Setter Target="PART_BoxContour.Background" Value="{StaticResource SeaGlassToneSeafoamMintBrush}" />
                            <Setter Target="PART_BoxContour.BorderBrush" Value="{StaticResource SeaGlassToneSeafoamMintBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unchecked">
                        <VisualState.Setters>
                            <Setter Target="PART_Checkmark.Visibility" Value="Collapsed" />
                            <Setter Target="PART_BoxContour.Background" Value="{ThemeResource SeaGlassSurfaceBackground}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Indeterminate">
                        <VisualState.Setters>
                            <Setter Target="PART_Checkmark.Visibility" Value="Visible" />
                            <Setter Target="PART_BoxContour.Background" Value="{StaticResource SeaGlassToneBeachAmberBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassCheckbox">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="4,4,4,4" />
        <Setter Property="Template" Value="{StaticResource SeaGlassCheckboxTemplate}" />
    </Style>

    <!-- 4. SeaGlassRadioButton Template -->
    <ControlTemplate x:Key="SeaGlassRadioButtonTemplate" TargetType="sg:SeaGlassRadioButton">
        <Grid x:Name="PART_Root">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Grid Width="22" Height="22" VerticalAlignment="Center">
                    <Border x:Name="PART_GlassHost"
                            Width="22"
                            Height="22"
                            CornerRadius="11"
                            Background="Transparent"
                            BorderThickness="0" />
                    <Border x:Name="PART_OuterRing"
                            CornerRadius="11"
                            BorderBrush="{ThemeResource SeaGlassSurfaceBorderBrush}"
                            BorderThickness="2"
                            Background="{ThemeResource SeaGlassSurfaceBackground}" />
                    <Border x:Name="PART_InnerDroplet"
                            Width="10"
                            Height="10"
                            CornerRadius="5"
                            Background="{StaticResource SeaGlassToneSeafoamMintBrush}"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                </Grid>
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  VerticalAlignment="Center" />
            </StackPanel>
            <Border x:Name="PART_FocusVisual"
                    CornerRadius="13"
                    BorderBrush="{StaticResource SeaGlassFocusStrokeBrush}"
                    BorderThickness="2"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="PART_OuterRing.BorderBrush" Value="{StaticResource SeaGlassRimHighlightBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="PART_OuterRing.Opacity" Value="0.8" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="PART_Root.Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CheckStates">
                    <VisualState x:Name="Checked">
                        <VisualState.Setters>
                            <Setter Target="PART_InnerDroplet.Visibility" Value="Visible" />
                            <Setter Target="PART_OuterRing.BorderBrush" Value="{StaticResource SeaGlassToneSeafoamMintBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unchecked">
                        <VisualState.Setters>
                            <Setter Target="PART_InnerDroplet.Visibility" Value="Collapsed" />
                            <Setter Target="PART_OuterRing.BorderBrush" Value="{ThemeResource SeaGlassSurfaceBorderBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassRadioButton">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="4,4,4,4" />
        <Setter Property="Template" Value="{StaticResource SeaGlassRadioButtonTemplate}" />
    </Style>

    <!-- 5. SeaGlassLiquidSlider Template -->
    <ControlTemplate x:Key="SeaGlassLiquidSliderTemplate" TargetType="sg:SeaGlassLiquidSlider">
        <Grid x:Name="PART_Root" Padding="{TemplateBinding Padding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Header Row with Title and ValueText -->
            <Grid Margin="0,0,0,6">
                <TextBlock x:Name="PART_TitlePresenter"
                           Text="{TemplateBinding Title}"
                           HorizontalAlignment="Left"
                           FontWeight="Medium"
                           FontSize="13"
                           Foreground="{ThemeResource SeaGlassSurfaceForeground}" />
                <TextBlock x:Name="PART_ValuePresenter"
                           Text="{TemplateBinding ValueText}"
                           HorizontalAlignment="Right"
                           FontSize="13"
                           Opacity="0.85"
                           Foreground="{ThemeResource SeaGlassSurfaceForeground}" />
            </Grid>
            <!-- Slider Track & Thumb Row -->
            <Grid Grid.Row="1" Height="32">
                <Border x:Name="PART_GlassHost"
                        Background="Transparent"
                        BorderThickness="0" />
                <Border x:Name="PART_Track"
                        Height="6"
                        CornerRadius="3"
                        Background="{ThemeResource SeaGlassSurfaceBorderBrush}"
                        VerticalAlignment="Center" />
                <Border x:Name="PART_ActiveTrackBar"
                        Height="6"
                        CornerRadius="3"
                        Background="{StaticResource SeaGlassToneSeafoamMintBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center" />
                <primitives:Thumb x:Name="PART_Thumb"
                                  Width="22"
                                  Height="22"
                                  CornerRadius="11"
                                  Background="{StaticResource SeaGlassToneSeafoamMintBrush}"
                                  BorderBrush="{StaticResource SeaGlassRimHighlightBrush}"
                                  BorderThickness="1.5"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center" />
            </Grid>
            <Border x:Name="PART_FocusVisual"
                    Grid.Row="1"
                    CornerRadius="8"
                    BorderBrush="{StaticResource SeaGlassFocusStrokeBrush}"
                    BorderThickness="2"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="PART_Thumb.BorderBrush" Value="{ThemeResource SeaGlassSurfaceForeground}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="PART_Thumb.Opacity" Value="0.9" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="PART_Root.Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style TargetType="sg:SeaGlassLiquidSlider">
        <Setter Property="Height" Value="60" />
        <Setter Property="Padding" Value="4,4,4,4" />
        <Setter Property="Template" Value="{StaticResource SeaGlassLiquidSliderTemplate}" />
    </Style>

</ResourceDictionary>
